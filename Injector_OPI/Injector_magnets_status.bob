<?xml version='1.0' encoding='UTF-8'?>
<display version="2.0.0">
  <width>820</width>
  <height>810</height>
  <background_color>
    <color name="Read_Background" red="240" green="240" blue="240">
    </color>
  </background_color>
  <actions>
    <action type="open_display">
      <description>Open Display</description>
      <file>Automatic_Action.opi</file>
      <target>tab</target>
    </action>
  </actions>
  <grid_step_x>6</grid_step_x>
  <grid_step_y>6</grid_step_y>
  <widget type="rectangle" version="2.0.0">
    <name>Rectangle</name>
    <macros>
      <pv_name />
    </macros>
    <width>822</width>
    <height>70</height>
    <line_width>0</line_width>
    <line_color>
      <color red="0" green="128" blue="255">
      </color>
    </line_color>
    <background_color>
      <color name="HeaderPanel" red="158" green="196" blue="224">
      </color>
    </background_color>
    <actions>
    </actions>
    <tooltip>$(pv_name)
$(pv_value)</tooltip>
  </widget>
  <widget type="label" version="2.0.0">
    <name>Label</name>
    <text>Equipments Status</text>
    <x>80</x>
    <y>24</y>
    <width>401</width>
    <font>
      <font name="Header 3" family="Liberation Sans" style="BOLD" size="16.0">
      </font>
    </font>
    <background_color>
      <color name="HeaderPanel" red="158" green="196" blue="224">
      </color>
    </background_color>
    <transparent>false</transparent>
    <horizontal_alignment>1</horizontal_alignment>
    <vertical_alignment>1</vertical_alignment>
    <actions>
    </actions>
    <border_color>
      <color red="0" green="128" blue="255">
      </color>
    </border_color>
  </widget>
  <widget type="action_button" version="3.0.0">
    <name>Action Button</name>
    <actions execute_as_one="true">
      <action type="open_display">
        <description>Open Display</description>
        <file>Injector_Help_Status.bob</file>
        <target>tab</target>
      </action>
    </actions>
    <text>Help &gt;&gt;</text>
    <x>576</x>
    <y>9</y>
    <width>115</width>
    <height>31</height>
    <background_color>
      <color name="HelpPanel" red="181" green="249" blue="215">
      </color>
    </background_color>
    <tooltip>$(actions)</tooltip>
    <border_alarm_sensitive>false</border_alarm_sensitive>
  </widget>
  <widget type="action_button" version="3.0.0">
    <name>Action Button_3</name>
    <actions>
      <action type="open_display">
        <description>Open Display</description>
        <file>Injector_Launcher.bob</file>
        <target>tab</target>
      </action>
    </actions>
    <text>Back</text>
    <x>708</x>
