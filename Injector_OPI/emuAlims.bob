        </color>
      </border_color>
    </widget>
    <widget type="textentry" version="3.0.0">
      <name>Text Input</name>
      <pv_name>ca://LEBT:EMIT_PS1:VSet</pv_name>
      <x>433</x>
      <y>58</y>
      <width>138</width>
      <height>33</height>
      <font>
        <font family="Courier" style="BOLD" size="11.881188118811881">
        </font>
      </font>
      <foreground_color>
        <color name="KeyboardEntry" red="0" green="255" blue="255">
        </color>
      </foreground_color>
      <background_color>
        <color name="TextBackground" red="70" green="70" blue="70">
        </color>
      </background_color>
      <format>1</format>
      <horizontal_alignment>1</horizontal_alignment>
      <actions>
      </actions>
      <tooltip>$(pv_name)</tooltip>
      <border_alarm_sensitive>false</border_alarm_sensitive>
      <border_width>1</border_width>
      <precision>-1</precision>
    </widget>
    <widget type="led" version="2.0.0">
      <name>LED_1</name>
      <pv_name>ca://LEBT:EMIT_PS1:OnOffCmd</pv_name>
      <x>55</x>
      <y>12</y>
      <width>18</width>
      <height>18</height>
      <off_color>
        <color red="0" green="100" blue="0">
        </color>
      </off_color>
      <foreground_color>
        <color red="192" green="192" blue="192">
        </color>
      </foreground_color>
      <actions>
      </actions>
      <tooltip>$(pv_name)</tooltip>
      <border_alarm_sensitive>false</border_alarm_sensitive>
    </widget>
    <widget type="scaledslider" version="2.0.0">
      <name>Scaled Slider</name>
      <pv_name>ca://LEBT:EMIT_PS1:VSet</pv_name>
      <x>102</x>
      <y>12</y>
      <width>320</width>
      <height>80</height>
      <background_color>
        <color red="240" green="240" blue="240">
        </color>
      </background_color>
      <transparent>false</transparent>
      <font>
        <font family="Sans" style="REGULAR" size="7.920792079207921">
        </font>
      </font>
      <major_tick_step_hint>100</major_tick_step_hint>
      <scale_format>0</scale_format>
      <level_hihi>10000.0</level_hihi>
      <level_high>9500.0</level_high>
      <level_low>-9500.0</level_low>
      <level_lolo>-10000.0</level_lolo>
      <show_hihi>false</show_hihi>
      <show_high>false</show_high>
      <show_low>false</show_low>
      <show_lolo>false</show_lolo>
      <actions>
      </actions>
      <tooltip />
      <border_alarm_sensitive>false</border_alarm_sensitive>
      <minimum>-10000.0</minimum>
      <maximum>10000.0</maximum>
      <limits_from_pv>true</limits_from_pv>
    </widget>
    <widget type="textupdate" version="2.0.0">
      <name>Text Update_2</name>
      <pv_name>ca://LEBT:EMIT_PS1:VRdbk</pv_name>
