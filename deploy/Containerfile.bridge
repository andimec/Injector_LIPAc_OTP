# Reference build for the isolated full-vacuum Python bridge.
# Run without privileged networking. Explicitly pin base image in production.
FROM python:3.12-slim
WORKDIR /opt/otp
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1
COPY pyproject.toml /opt/otp/
COPY src /opt/otp/src
RUN python -m pip install --no-cache-dir 'caproto>=1.1,<2' && \
    python -m pip install --no-cache-dir -e /opt/otp
USER 1000:1000
ENTRYPOINT ["python", "-m", "injector_otp.epics.vacuum_full_bridge"]
