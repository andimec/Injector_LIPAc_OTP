<?xml version='1.0' encoding='UTF-8'?>
<display version="2.0.0">
  <name>EMU PS</name>
  <width>630</width>
  <height>510</height>
  <background_color>
    <color name="Read_Background" red="240" green="240" blue="240">
    </color>
  </background_color>
