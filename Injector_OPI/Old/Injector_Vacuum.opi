	widget.setPropertyValue("text","Underrange");
else if(pv0 >= 5E-3)
	widget.setPropertyValue("text","Overrange");
else
	widget.setPropertyValue("text",pv0.toExponential(2).toUpperCase() + " mbar");]]></scriptText>
