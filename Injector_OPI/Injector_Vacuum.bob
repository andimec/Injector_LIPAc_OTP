    <scripts>
      <script file="EmbeddedJs">
        <text>importPackage(Packages.org.csstudio.opibuilder.scriptUtil);
var pv0 = PVUtil.getDouble(pvs[0]);
if(pv0 &lt;= 8E-4)
	widget.setPropertyValue("text","Underrange");
else if(pv0 &gt;= 1E3)
	widget.setPropertyValue("text","Overrange");
else
	widget.setPropertyValue("text",pv0.toExponential(2).toUpperCase() + " mbar");</text>
        <pv_name>ca://LEBT:VAC02:VacPGTP</pv_name>
      </script>
    </scripts>
    <tooltip>$(pv_name)
$(pv_value)</tooltip>
    <border_color>
      <color red="0" green="128" blue="255">
      </color>
    </border_color>
  </widget>
