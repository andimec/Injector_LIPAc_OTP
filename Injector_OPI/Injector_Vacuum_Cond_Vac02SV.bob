      <width>1</width>
      <height>50</height>
      <points>
        <point x="0.0" y="0.0">
        </point>
        <point x="0.0" y="49.0">
        </point>
      </points>
      <line_width>5</line_width>
      <line_color>
        <color name="Disconnected" red="255" green="0" blue="255">
        </color>
      </line_color>
      <actions>
      </actions>
      <rules>
        <rule name="BgColor" prop_id="line_color" out_exp="false">
          <exp bool_exp="pv0==0">
            <value>
              <color name="Major" red="255" green="0" blue="0">
              </color>
            </value>
          </exp>
          <exp bool_exp="pv0==1">
            <value>
              <color name="Green" red="0" green="255" blue="0">
              </color>
            </value>
          </exp>
          <pv_name>ca://LEBT:VAC02:TPSpeedStat</pv_name>
        </rule>
      </rules>
      <tooltip>$(pv_name)
$(pv_value)</tooltip>
    </widget>
  </widget>
</display>