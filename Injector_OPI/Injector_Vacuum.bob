  <widget type="label" version="2.0.0">
    <name>Text Update_4</name>
    <macros>
      <pv_name />
    </macros>
    <text>######</text>
    <x>721</x>
    <y>381</y>
    <width>110</width>
    <height>18</height>
    <foreground_color>
      <color name="TextDynamic" red="0" green="244" blue="0">
      </color>
    </foreground_color>
    <background_color>
      <color name="TextBackground" red="70" green="70" blue="70">
      </color>
    </background_color>
    <transparent>false</transparent>
    <vertical_alignment>1</vertical_alignment>
    <wrap_words>false</wrap_words>
    <actions>
    </actions>
    <scripts>
      <script file="EmbeddedJs">
        <text>importPackage(Packages.org.csstudio.opibuilder.scriptUtil);
var pv0 = PVUtil.getDouble(pvs[0]);
if(pv0 &lt;= 1E-10)
	widget.setPropertyValue("text","Underrange");
else if(pv0 &gt;= 5E-3)
	widget.setPropertyValue("text","Overrange");
else
	widget.setPropertyValue("text",pv0.toExponential(2).toUpperCase() + " mbar");</text>
        <pv_name>ca://LEBT:VAC02:VacSGTP</pv_name>
      </script>
    </scripts>
    <tooltip>$(pv_name)
$(pv_value)</tooltip>
    <border_color>
      <color red="0" green="128" blue="255">
      </color>
    </border_color>
  </widget>
