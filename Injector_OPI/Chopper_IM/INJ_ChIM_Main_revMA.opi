  <widget typeId="org.csstudio.opibuilder.widgets.TextUpdate" version="1.0.0">
    <border_style>0</border_style>
    <forecolor_alarm_sensitive>false</forecolor_alarm_sensitive>
    <alarm_pulsing>false</alarm_pulsing>
    <precision>0</precision>
    <tooltip></tooltip>
    <horizontal_alignment>0</horizontal_alignment>
    <rules>
      <rule name="State name" prop_id="text" out_exp="false">
        <exp bool_exp="pv0==0">
          <value>  0: CONFIGURATION</value>
        </exp>
        <exp bool_exp="pv0==1">
          <value>  1: PRE-ARM</value>
        </exp>
        <exp bool_exp="pv0==2">
          <value>  2: ARMED</value>
        </exp>
        <exp bool_exp="pv0==3">
          <value>  3: GATE OFF</value>
        </exp>
        <exp bool_exp="pv0==4">
          <value>  4: GATE ON: RISING</value>
        </exp>
        <exp bool_exp="pv0==5">
          <value>  5: GATE ON</value>
        </exp>
        <exp bool_exp="pv0==6">
          <value>  6: GATE OFF: DECREASING</value>
        </exp>
        <pv trig="true">LEBT:CHOP_IM:FbiStmState</pv>
      </rule>
      <rule name="Foreground" prop_id="foreground_color" out_exp="false">
        <exp bool_exp="pv0==0 &amp;&amp; pv1==1">
          <value>
            <color name="TextDynamic" red="0" green="244" blue="0" />
          </value>
        </exp>
        <exp bool_exp="pv0!=0 || pv1!=1">
          <value>
            <color red="127" green="127" blue="127" />
          </value>
        </exp>
        <pv trig="true">LEBT:CHOP_IM:Fbi</pv>
        <pv trig="true">LEBT:CHOP_IM:StmState</pv>
      </rule>
    </rules>
    <enabled>true</enabled>
    <wuid>-6e86f59d:160545931c0:-7f4a</wuid>
    <transparent>false</transparent>
    <pv_value />
    <auto_size>false</auto_size>
