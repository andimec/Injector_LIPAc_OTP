                  <color name="Major" red="255" green="0" blue="0">
                  </color>
                </value>
              </exp>
              <exp bool_exp="pv0==1">
                <value>
                  <color name="Green" red="0" green="255" blue="0">
                  </color>
                </value>
              </exp>
              <pv_name>ca://SRC:IE_PS:OnStat</pv_name>
            </rule>
          </rules>
