  <widget type="rectangle" version="2.0.0">
    <name>Rounded Rectangle</name>
    <macros>
      <pv_name>ca://LEBT:HV_PS:ExtSec</pv_name>
    </macros>
    <x>1029</x>
    <y>275</y>
    <width>169</width>
    <height>43</height>
    <line_width>0</line_width>
    <line_color>
      <color red="0" green="128" blue="255">
      </color>
    </line_color>
    <corner_width>16</corner_width>
    <corner_height>16</corner_height>
    <actions>
    </actions>
    <rules>
      <rule name="Rule" prop_id="background_color" out_exp="false">
        <exp bool_exp="pv0==0">
          <value>
            <color name="Major" red="255" green="0" blue="0">
            </color>
          </value>
        </exp>
        <exp bool_exp="pv0==1">
          <value>
            <color name="Green" red="0" green="255" blue="0">
            </color>
          </value>
        </exp>
        <pv_name>ca://LEBT:HV_PS:ExtSec</pv_name>
      </rule>
    </rules>
    <tooltip>$(pv_name)
$(pv_value)</tooltip>
  </widget>
