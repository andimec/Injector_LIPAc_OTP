    <widget type="bool_button" version="2.0.0">
      <name>Boolean Button</name>
      <pv_name>ca://LEBT:EMIT:Validate</pv_name>
      <bit>-1</bit>
      <x>407</x>
      <y>225</y>
      <height>31</height>
      <off_label>validate</off_label>
      <off_color>
        <color red="240" green="240" blue="240">
        </color>
      </off_color>
      <on_label>ON</on_label>
      <on_color>
        <color red="192" green="192" blue="192">
        </color>
      </on_color>
      <show_led>false</show_led>
      <background_color>
        <color red="240" green="240" blue="240">
        </color>
      </background_color>
      <actions>
      </actions>
      <scripts>
        <script file="EmbeddedPy">
          <text>from org.csstudio.opibuilder.scriptUtil import PVUtil
from javax.swing import JOptionPane

# Get the current value of the trigger PV (pvs[0])
trigger_val = PVUtil.getDouble(pvs[0])

# Get the previously stored value (if any)
last_val = widget.getVar("last_trigger_val")

# Only trigger on rising edge: 0 to 1
if last_val != 1 and trigger_val == 1:

    # Get other PV values
    init_val = PVUtil.getDouble(pvs[1])
    end_val = PVUtil.getDouble(pvs[2])
    upper = PVUtil.getDouble(pvs[3])
    lower = PVUtil.getDouble(pvs[4])

    if upper &lt; lower:
        JOptionPane.showMessageDialog(None, 
            "Value for 'upper' needs to be higher than value for 'lower'", 
            "WARNING", 
            JOptionPane.INFORMATION_MESSAGE)

    if init_val == -9999 or end_val == 9999:
        JOptionPane.showMessageDialog(None, 
            "Values for 'angle peak (init)' and 'angle peak(end)' must be given before measurement starts!", 
            "WARNING", 
            JOptionPane.INFORMATION_MESSAGE)

# Store the current value for next time
widget.setVar("last_trigger_val", trigger_val)</text>
          <pv_name>ca://LEBT:EMIT:Validate</pv_name>
          <pv_name trigger="false">ca://LEBT:EMIT:AnglePicInit</pv_name>
          <pv_name trigger="false">ca://LEBT:EMIT:AnglePicEnd</pv_name>
          <pv_name trigger="false">ca://LEBT:EMIT:Borderup</pv_name>
          <pv_name trigger="false">ca://LEBT:EMIT:Borderlow</pv_name>
        </script>
      </scripts>
      <border_alarm_sensitive>false</border_alarm_sensitive>
    </widget>
