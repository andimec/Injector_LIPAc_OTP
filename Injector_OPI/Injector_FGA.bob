          </font>
        </scale_font>
        <on_right>false</on_right>
        <visible>true</visible>
        <color>
          <color name="Text" red="0" green="0" blue="0">
          </color>
        </color>
      </y_axis>
    </y_axes>
    <traces>
      <trace>
        <name>$(traces[0].y_pv)</name>
        <x_pv>ca://LEBT:FGA_PS3:Vgrid</x_pv>
        <y_pv>ca://LEBT:FGA_PS3:Vgrid</y_pv>
        <err_pv />
        <axis>0</axis>
        <trace_type>1</trace_type>
        <color>
