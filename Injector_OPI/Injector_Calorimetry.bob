  <widget type="action_button" version="3.0.0">
    <name>Action Button_1</name>
    <actions execute_as_one="true">
      <action type="execute">
        <description>FC compensation execute on demand</description>
        <script file="EmbeddedJs">
          <text>importPackage(Packages.org.csstudio.opibuilder.scriptUtil);
importPackage(Packages.org.eclipse.jface.dialogs);

var tincalcPV = display.getWidget("Text_Update_FC_Tincalc").getPV();
var toutcalcPV = display.getWidget("Text_Update_FC_Toutcalc").getPV();
var compPV = widget.getPV();

var tincalcVal = PVUtil.getDouble(tincalcPV);
var toutcalcVal = PVUtil.getDouble(toutcalcPV);
var compVal = toutcalcVal - tincalcVal;

compPV.setValue(compVal);

</text>
        </script>
      </action>
    </actions>
    <pv_name>ca://LEBT:FC:Comp</pv_name>
    <text>Set</text>
    <x>165</x>
    <y>430</y>
    <width>46</width>
    <height>31</height>
    <foreground_color>
      <color name="Black" red="0" green="0" blue="0">
      </color>
    </foreground_color>
    <tooltip />
    <border_alarm_sensitive>false</border_alarm_sensitive>
  </widget>
