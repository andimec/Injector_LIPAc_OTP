    }
    field(DISS, DBF_MENU) {
        interest(1)
        promptgroup("70 - Alarm")
        menu(menuAlarmSevr)
        prompt("Disable Alarm Sevrty")
    }
    field(LCNT, DBF_UCHAR) {
