        special(SPC_NOMOD)
    }
    field(RBV, DBF_DOUBLE) {
        special(SPC_NOMOD)
        prompt("User Readback Value")
    }
    field(DRBV, DBF_DOUBLE) {
        prompt("Dial Readback Value")
        special(SPC_NOMOD)
    }
    field(DIFF, DBF_DOUBLE) {
        prompt("Difference dval-drbv")
        special(SPC_NOMOD)
    }
    field(RDIF, DBF_LONG) {
        special(SPC_NOMOD)
        prompt("Difference rval-rrbv")
    }
    field(CDIR, DBF_SHORT) {
        prompt("Raw cmnd direction")
        special(SPC_NOMOD)
    }
    field(RRBV, DBF_LONG) {
        prompt("Raw Readback Value")
        special(SPC_NOMOD)
    }
    field(RMP, DBF_LONG) {
        prompt("Raw Motor Position")
        special(SPC_NOMOD)
    }
    field(REP, DBF_LONG) {
        prompt("Raw Encoder Position")
        special(SPC_NOMOD)
    }
    field(RVEL, DBF_LONG) {
        special(SPC_NOMOD)
        prompt("Raw Velocity")
        interest(1)
        promptgroup("10 - Common")
    }
    field(DMOV, DBF_SHORT) {
        promptgroup("10 - Common")
        initial("1")
        prompt("Done moving to value")
        special(SPC_NOMOD)
    }
    field(MOVN, DBF_SHORT) {
        special(SPC_NOMOD)
        prompt("Motor is moving")
    }
    field(MSTA, DBF_ULONG) {
        interest(3)
        prompt("Motor Status")
        special(SPC_NOMOD)
    }
    field(LVIO, DBF_SHORT) {
        special(SPC_NOMOD)
        prompt("Limit violation")
        initial("1")
    }
    field(TDIR, DBF_SHORT) {
        prompt("Direction of Travel")
        special(SPC_NOMOD)
    }
    field(ATHM, DBF_SHORT) {
        prompt("At HOME")
        special(SPC_NOMOD)
    }
    field(PP, DBF_SHORT) {
        prompt("Post process command")
        special(SPC_NOMOD)
        interest(2)
        initial("0")
    }
    field(MIP, DBF_USHORT) {
        interest(3)
        prompt("Motion In Progress")
        special(SPC_NOMOD)
    }
    field(MMAP, DBF_ULONG) {
        interest(3)
        prompt("Monitor Mask")
        special(SPC_NOMOD)
    }
    field(NMAP, DBF_ULONG) {
        interest(3)
        prompt("Monitor Mask (more)")
        special(SPC_NOMOD)
    }
    field(DLY, DBF_DOUBLE) {
        promptgroup("10 - Common")
        interest(1)
        prompt("Readback settle time (s)")
        special(SPC_MOD)
    }
    field(CBAK, DBF_NOACCESS) {
        extra("void             *cbak")
        prompt("Callback structure")
        special(SPC_NOMOD)
        interest(4)
        size(4)
    }
    field(PCOF, DBF_DOUBLE) {
        initial("0")
        promptgroup("10 - Common")
        interest(1)
        prompt("Proportional Gain")
        special(SPC_MOD)
    }
    field(ICOF, DBF_DOUBLE) {
        initial("0")
        promptgroup("10 - Common")
        interest(1)
        prompt("Integral Gain")
        special(SPC_MOD)
    }
    field(DCOF, DBF_DOUBLE) {
        prompt("Derivative Gain")
        special(SPC_MOD)
        interest(1)
        promptgroup("10 - Common")
        initial("0")
    }
    field(CNEN, DBF_MENU) {
        menu(motorTORQ)
        promptgroup("10 - Common")
        asl(ASL0)
        pp(TRUE)
        special(SPC_MOD)
        prompt("Enable control")
    }
    field(INIT, DBF_STRING) {
        size(40)
        promptgroup("10 - Common")
        interest(1)
        prompt("Startup commands")
    }
    field(PREM, DBF_STRING) {
        prompt("Pre-move commands")
        size(40)
        interest(1)
        promptgroup("10 - Common")
    }
    field(POST, DBF_STRING) {
        prompt("Post-move commands")
        size(40)
        interest(1)
        promptgroup("10 - Common")
    }
    field(STOO, DBF_OUTLINK) {
        promptgroup("10 - Common")
        interest(1)
        prompt("STOP OutLink")
        special(SPC_MOD)
    }
    field(DINP, DBF_INLINK) {
        prompt("DMOV Input Link")
        special(SPC_MOD)
        promptgroup("10 - Common")
        interest(1)
    }
    field(RINP, DBF_INLINK) {
        prompt("RMP Input Link")
        special(SPC_MOD)
        interest(1)
        promptgroup("10 - Common")
    }
    field(JVEL, DBF_DOUBLE) {
        promptgroup("10 - Common")
        interest(1)
        special(SPC_MOD)
        prompt("Jog Velocity (EGU/s)")
    }
    field(JAR, DBF_DOUBLE) {
        special(SPC_MOD)
        prompt("Jog Accel. (EGU/s^2)")
        interest(1)
        promptgroup("10 - Common")
    }
    field(LOCK, DBF_MENU) {
        menu(menuYesNo)
        initial("NO")
        promptgroup("10 - Common")
        interest(1)
        prompt("Soft Channel Position Lock")
    }
    field(NTM, DBF_MENU) {
        prompt("New Target Monitor")
        interest(1)
        promptgroup("10 - Common")
        initial("YES")
        menu(menuYesNo)
    }
    field(NTMF, DBF_USHORT) {
        initial("2")
        promptgroup("10 - Common")
        interest(1)
        prompt("NTM Deadband Factor")
        special(SPC_MOD)
    }
    field(HVEL, DBF_DOUBLE) {
        interest(1)
        promptgroup("10 - Common")
        special(SPC_MOD)
        prompt("Home Velocity (EGU/s)")
    }
    field(STUP, DBF_MENU) {
        pp(TRUE)
        promptgroup("10 - Common")
        menu(motorSTUP)
        initial("OFF")
        asl(ASL0)
        special(SPC_MOD)
        prompt("Status Update")
        interest(3)
    }
    field(RMOD, DBF_MENU) {
        interest(1)
        promptgroup("10 - Common")
        menu(motorRMOD)
        initial("Default")
        prompt("Retry Mode")
    }
    field(ADEL, DBF_DOUBLE) {
        prompt("Archive Deadband")
        promptgroup("10 - Common")
        interest(1)
    }
    field(MDEL, DBF_DOUBLE) {
        promptgroup("10 - Common")
        interest(1)
        prompt("Monitor Deadband")
    }
    field(ALST, DBF_DOUBLE) {
        interest(3)
        prompt("Last Value Archived")
        special(SPC_NOMOD)
    }
    field(MLST, DBF_DOUBLE) {
        prompt("Last Val Monitored")
        special(SPC_NOMOD)
        interest(3)
    }
    field(SYNC, DBF_SHORT) {
        interest(1)
        pp(TRUE)
        prompt("Sync position")
    }
    field(IGSET, DBF_SHORT) {
        interest(2)
        prompt("Ignore SET field")
    }
    field(RSTM, DBF_MENU) {
        initial("NearZero")
        menu(motorRSTM)
        interest(2)
        promptgroup("10 - Common")
        prompt("Restore Mode")
    }
}
device(motor, CONSTANT, devMotorSoft, "Soft Channel")
recordtype(stringin) {
}
device(stringin, CONSTANT, devInjectorSi, "Injector Soft Channel")
recordtype(stringout) {
}
device(stringout, CONSTANT, devInjectorSo, "Injector Soft Channel")
recordtype(waveform) {
}
device(waveform, CONSTANT, devInjectorWf, "Injector Soft Channel")
