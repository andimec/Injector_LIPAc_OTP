    <rules>
      <rule name="Rule" prop_id="background_color" out_exp="false">
        <exp bool_exp="pv0==0 &amp;&amp; pv1 ==1">
          <value>
            <color name="Major" red="255" green="0" blue="0">
            </color>
          </value>
        </exp>
        <exp bool_exp="pv0==1 &amp;&amp; pv1 ==0">
          <value>
            <color name="Green" red="0" green="255" blue="0">
            </color>
          </value>
        </exp>
        <exp bool_exp="pv0==0 &amp;&amp; pv1==0">
          <value>
            <color red="240" green="240" blue="0">
            </color>
          </value>
        </exp>
        <exp bool_exp="pv0==1 &amp;&amp; pv1==1">
          <value>
            <color red="240" green="240" blue="0">
            </color>
          </value>
        </exp>
        <pv_name>ca://LEBT:GV:OpenStat</pv_name>
        <pv_name>ca://LEBT:GV:CloseStat</pv_name>
      </rule>
    </rules>
    <tooltip>$(pv_name)
$(pv_value)</tooltip>
  </widget>
